Definition declare_list_in_scope_exec'_def:
 declare_list_in_scope_exec' (t_scope:t_scope, scope:scope) =
  FOLDR (\(x, (t, lvalop)) f. p4$AUPDATE f (x, (init_v_from_tau_cake t, NONE))) scope t_scope
