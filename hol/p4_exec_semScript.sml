     | _ => NONE
     ) /\
 (lookup_lval_exec ss (lval_null) = NONE ) /\
 (lookup_lval_exec ss (lval_paren lval) = lookup_lval_exec ss lval)
End
*)
Definition vl_of_el_exec_def:
 (vl_of_el_exec [] = SOME []) /\
 (vl_of_el_exec (h::t) =
   case get_v h of
    | SOME v =>
     (case vl_of_el_exec t of
      | SOME v_l => SOME (v::v_l)
      | NONE => NONE)
    | NONE => NONE)
End

