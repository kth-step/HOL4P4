Definition lookup_lval_exec_def:
  (lookup_lval_exec (ss:scope list) (lval_varname x) = lookup_v ss x) /\
  (lookup_lval_exec ss (lval_field lval f) =
     case lookup_lval_exec ss lval of
     | SOME v => acc_f v f
